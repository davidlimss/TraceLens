APP_VERSION=0.2.0-beta.1
APP_ENV=development
REQUIRE_MIGRATIONS=true
SCHEMA_REVISION=0007_vigil_replay_snapshots
POSTGRES_DB=loginvestigator
POSTGRES_USER=loginvestigator
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://loginvestigator:change-me@postgres:5432/loginvestigator
REDIS_URL=redis://redis:6379/0
EVIDENCE_STORAGE_PATH=/app/storage/evidence
CORS_ORIGINS=http://localhost:3001
SERVER_TIMEZONE=Asia/Jakarta
CORRELATION_WINDOW_MINUTES=10
BRUTE_FORCE_WINDOW_MINUTES=10
BRUTE_FORCE_THRESHOLD=5
GITHUB_MODELS_TOKEN=your-github-models-token
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4.1
# Hosted provider override (example: Gemini API; leave provider=github_models to use legacy settings)
LLM_PROVIDER=groq
LLM_API_KEY=your-groq-api-key
LLM_ENDPOINT=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_TOOL_ROUNDS=8
LLM_MAX_TOOL_CALLS=20
MAX_UPLOAD_BYTES=52428800
UPLOAD_RATE_LIMIT=10
CHAT_RATE_LIMIT=20
LOGIN_RATE_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60
NEXT_PUBLIC_API_URL=http://localhost:8002
BACKEND_PORT=8002
FRONTEND_PORT=3001
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-local
SESSION_TTL_HOURS=12
SECURE_COOKIES=false
LLM_MAX_SAME_TOOL_REPETITION=2
LLM_NO_PROGRESS_LIMIT=2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOOL_RESULT_CHARACTERS=8000
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_REPAIR_ATTEMPTS=2
LLM_MAX_PLAN_REVISIONS=3
LLM_MAX_HYPOTHESES=8
ALLOW_RAW_LOG_TO_EXTERNAL_PROVIDER=false
STUCK_JOB_MINUTES=10
AGENT_STUCK_MINUTES=5
INTEGRITY_CHECK_INTERVAL_SECONDS=86400
EXTERNAL_SOURCES_ENABLED=false
EXTERNAL_CASE_FIELD=tracelens.case_id
EXTERNAL_SEARCH_TIMEOUT_SECONDS=15
EXTERNAL_MAX_RESULTS=100
EXTERNAL_MAX_RETRIES=2
EXTERNAL_CIRCUIT_BREAKER_THRESHOLD=3
EXTERNAL_CIRCUIT_BREAKER_WINDOW_SECONDS=60
# OpenSearch (read-only credential/index; no arbitrary DSL is accepted by the agent)
OPENSEARCH_URL=https://opensearch.example:9200
OPENSEARCH_INDEX=security-logs-*
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_API_KEY=
# Splunk (read-only token; TraceLens builds a restricted SPL query)
SPLUNK_URL=https://splunk.example:8089
SPLUNK_INDEX=security
SPLUNK_TOKEN=
SPLUNK_CASE_FIELD=tracelens_case_id
# Wazuh indexer (alerts are read from the Wazuh indexer, not active-response APIs)
WAZUH_INDEXER_URL=https://wazuh-indexer.example:9200
WAZUH_INDEX=wazuh-alerts-*
WAZUH_USERNAME=
WAZUH_PASSWORD=
WAZUH_API_KEY=
MCP_EXTERNAL_IN_PROCESS=true
